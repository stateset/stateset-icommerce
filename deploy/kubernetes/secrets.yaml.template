# StateSet iCommerce Kubernetes Secrets
# NOTE: In production, use sealed-secrets, external-secrets, or Vault
# This file is a template - replace values before applying

apiVersion: v1
kind: Secret
metadata:
  name: stateset-secrets
  namespace: stateset
  labels:
    app.kubernetes.io/name: stateset
    app.kubernetes.io/part-of: stateset-icommerce
type: Opaque
stringData:
  # Anthropic API key for Claude integration
  # Replace with your actual API key
  anthropic-api-key: "your-anthropic-api-key-here"
---
apiVersion: v1
kind: Secret
metadata:
  name: stateset-postgres-secrets
  namespace: stateset
  labels:
    app.kubernetes.io/name: stateset-postgres
    app.kubernetes.io/part-of: stateset-icommerce
type: Opaque
stringData:
  # PostgreSQL credentials
  # Replace with secure values in production
  username: "stateset"
  password: "change-me-in-production"
  # Full connection string
  database-url: "postgres://stateset:change-me-in-production@stateset-postgres:5432/stateset"
