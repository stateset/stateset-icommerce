    }
  },
  "expected_canonical": "{\"agent\":\"aid:v1:zVectorAgent\",\"authority\":{\"max_per_intent\":{\"amount\":\"500.00\",\"currency\":\"USDC\"},\"verbs\":[\"purchase.create\",\"inventory.query\"]},\"expiry\":\"2026-01-01T00:00:00.000Z\",\"principal\":\"did:web:vector.example\",\"revocation\":\"https://vector.example/revoke\"}",
  "expected_signature_hex": "70f9e4fd1b2f081bd0f81c64c46d648d4730464a031122836c2fb931ff93fc86e8b6cf694d7389a1e61924ed69627d6dab62d050bfeb3c122a6f32573e1a6605"
