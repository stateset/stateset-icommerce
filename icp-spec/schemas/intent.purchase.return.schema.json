{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icp.stateset.com/schemas/icp-1.0/intent.purchase.return.json",
  "title": "ICP-1.0 Intent: purchase.return",
  "description": "A buyer Agent's signed request to return goods or services from a prior settlement. See ICP-1.0 §6.2.",
  "type": "object",
  "required": [
    "verb",
    "v",
    "intent_id",
    "buyer",
    "merchant",
    "settler",
    "original_settlement_id",
    "items",
    "desired_outcome",
    "principal_binding",
    "nonce",
    "iat",
    "exp"
  ],
  "additionalProperties": false,
  "properties": {
    "verb": { "const": "purchase.return" },
    "v": { "const": "icp-1.0" },
    "intent_id": {
      "type": "string",
      "pattern": "^icp_int_[0-9A-HJKMNP-TV-Z]{26}$"
    },
    "buyer": { "$ref": "intent.purchase.create.schema.json#/$defs/AID" },
    "merchant": { "$ref": "intent.purchase.create.schema.json#/$defs/AID" },
    "settler": { "$ref": "intent.purchase.create.schema.json#/$defs/SettlerID" },
    "original_settlement_id": {
      "type": "string",
      "pattern": "^icp_set_[0-9A-HJKMNP-TV-Z]{26}$",
      "description": "settlement_id of the original SettlementReceipt being returned against."
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["sku", "quantity"],
        "additionalProperties": false,
        "properties": {
          "sku": { "type": "string", "minLength": 1, "maxLength": 256 },
          "quantity": { "type": "integer", "minimum": 1 },
          "reason": {
            "type": "string",
            "enum": ["defective", "not-as-described", "no-longer-needed", "wrong-item", "damaged-in-transit", "other"]
          }
        }
      }
    },
    "desired_outcome": {
      "type": "string",
      "enum": ["refund", "replacement", "credit", "partial-refund"],
      "description": "What the buyer is asking for. Merchant MAY return a different outcome (e.g. credit instead of refund) per its policy."
    },
    "max_refund": {
      "$ref": "intent.purchase.create.schema.json#/$defs/Money",
      "description": "Authoritative ceiling on refund amount. Merchant ReturnAuthorization with refund.amount > max_refund MUST be rejected by conformant buyer Agents (§6.2)."
    },
    "narrative": {
      "type": "string",
      "maxLength": 2048,
      "description": "Optional human-readable explanation. May be surfaced to dispute arbiters."
    },
    "principal_binding": {
      "$ref": "intent.purchase.create.schema.json#/$defs/PrincipalBinding",
      "description": "MUST grant `purchase.return` in authority.verbs."
    },
    "nonce": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{32}$"
    },
    "iat": { "$ref": "intent.purchase.create.schema.json#/$defs/Timestamp" },
    "exp": {
      "$ref": "intent.purchase.create.schema.json#/$defs/Timestamp",
      "description": "MUST be <= iat + 600 seconds (ICP-1.0 §5.3)."
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true,
      "description": "Implementation-defined. May carry photo URLs, condition notes, etc. Verifiers MUST ignore unknown keys."
    }
  }
}
