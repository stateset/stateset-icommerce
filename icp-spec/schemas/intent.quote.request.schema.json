{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://icp.stateset.com/schemas/icp-1.0/intent.quote.request.json",
  "title": "ICP-1.0 Intent: quote.request",
  "description": "A buyer Agent's signed request for pricing without commitment (B2B wholesale RFQ). See ICP-1.0 §6.4 and ICPIP-0003.",
  "type": "object",
  "required": [
    "verb",
    "v",
    "intent_id",
    "buyer",
    "merchant",
    "settler",
    "items",
    "principal_binding",
    "nonce",
    "iat",
    "exp"
  ],
  "additionalProperties": false,
  "properties": {
    "verb": { "const": "quote.request" },
    "v": { "const": "icp-1.0" },
    "intent_id": { "type": "string", "pattern": "^icp_int_[0-9A-HJKMNP-TV-Z]{26}$" },
    "buyer": { "$ref": "intent.purchase.create.schema.json#/$defs/AID" },
    "merchant": { "$ref": "intent.purchase.create.schema.json#/$defs/AID" },
    "settler": { "$ref": "intent.purchase.create.schema.json#/$defs/SettlerID" },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": ["sku", "quantity"],
        "additionalProperties": false,
        "properties": {
          "sku": { "type": "string", "minLength": 1, "maxLength": 256 },
          "quantity": { "type": "integer", "minimum": 1 },
          "target_unit_price": { "$ref": "intent.purchase.create.schema.json#/$defs/Money" },
          "specifications": { "type": "object", "additionalProperties": true }
        }
      }
    },
    "ship_to": { "$ref": "intent.purchase.create.schema.json#/$defs/Address" },
    "expected_delivery_by": { "$ref": "intent.purchase.create.schema.json#/$defs/Timestamp" },
    "purchase_window": {
      "type": "string",
      "pattern": "^([1-9][0-9]*)(s|m|h|d|w|y)$",
      "description": "How long the buyer will hold the decision; merchant SHOULD honor pricing for this period."
    },
    "context": { "type": "string", "maxLength": 256 },
    "principal_binding": { "$ref": "intent.purchase.create.schema.json#/$defs/PrincipalBinding" },
    "nonce": { "type": "string", "pattern": "^[0-9a-fA-F]{32}$" },
    "iat": { "$ref": "intent.purchase.create.schema.json#/$defs/Timestamp" },
    "exp": { "$ref": "intent.purchase.create.schema.json#/$defs/Timestamp" },
    "metadata": { "type": "object", "additionalProperties": true }
  }
}
