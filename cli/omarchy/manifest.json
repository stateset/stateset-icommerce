{
  "schemaVersion": 1,
  "id": "com.stateset.icommerce",
  "name": "StateSet iCommerce",
  "version": "1.30.0",
  "author": "StateSet",
  "license": "MIT OR Apache-2.0",
  "description": "Local commerce status, backups, and agent access for Omarchy.",
  "kinds": [
    "service",
    "bar-widget"
  ],
  "entryPoints": {
    "service": "Service.qml",
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "StateSet Commerce",
    "description": "Store health, operating mode, and commerce actions.",
    "category": "System",
    "aliases": [
      "commerce",
      "icommerce",
      "stateset"
    ],
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 120,
      "notifications": true,
      "notificationCooldownMin": 15,
      "notifyFailedPayments": true,
      "notifyLowStock": true,
      "notifyPendingReturns": true
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 30,
        "max": 1800,
        "step": 30,
        "defaultValue": 120
      },
      {
        "key": "notifications",
        "type": "boolean",
        "label": "Desktop notifications",
        "defaultValue": true
      },
      {
        "key": "notificationCooldownMin",
        "type": "integer",
        "label": "Notification cooldown (minutes)",
        "min": 1,
        "max": 240,
        "step": 1,
        "defaultValue": 15
      },
      {
        "key": "notifyFailedPayments",
        "type": "boolean",
        "label": "Notify on failed payments",
        "defaultValue": true
      },
      {
        "key": "notifyLowStock",
        "type": "boolean",
        "label": "Notify on low stock",
        "defaultValue": true
      },
      {
        "key": "notifyPendingReturns",
        "type": "boolean",
        "label": "Notify on pending returns",
        "defaultValue": true
      }
    ]
  }
}
