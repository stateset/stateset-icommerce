    "slack",
    "discord",
    "signal",
    "google-chat",
    "skills",
    "marketplace",
    "multi-model",
    "openai",
    "gemini",
    "ollama",
    "extended-thinking",
    "streaming",
    "memory",
    "systemd",
    "tailscale",
    "daemon"
  ],
  "author": "StateSet <support@stateset.com>",
  "license": "MIT OR Apache-2.0",
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "bin/",
    "src/",
    "skills/",
    "deploy/",
    ".claude/"
