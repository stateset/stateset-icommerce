    "@slack/bolt": "^3.17.0",
    "@whiskeysockets/baileys": "^7.0.0-rc.9",
    "discord.js": "^14.14.0",
    "googleapis": "^130.0.0",
    "grammy": "^1.21.0",
    "qrcode-terminal": "^0.12.0",
    "botbuilder": "^4.23.0",
