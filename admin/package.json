{
  "name": "stateset-admin",
  "version": "1.26.0",
  "private": true,
  "engines": {
    "node": ">=20.20.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "check:env": "node ../scripts/check-node.mjs 20.20.0 10.0.0",
    "check": "npm run check:env && npm run typecheck && npm run typecheck:tests && npm run lint && npm run test",
    "prebuild": "npm run check:env",
    "pretypecheck": "npm run check:env",
    "pretypecheck:tests": "npm run check:env",
    "prelint": "npm run check:env",
    "pretest": "npm run check:env",
    "pretest:coverage": "npm run check:env",
    "preanalyze": "npm run check:env",
    "lint": "next lint --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "analyze": "ANALYZE=true next build"
  },
  "dependencies": {
    "@heroicons/react": "^2.0.18",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.0.6",
    "@radix-ui/react-label": "^2.0.2",
    "@radix-ui/react-select": "^2.0.0",
    "@radix-ui/react-separator": "^1.0.4",
    "@radix-ui/react-slot": "^1.0.4",
    "@radix-ui/react-tabs": "^1.0.4",
    "@radix-ui/react-toast": "^1.1.5",
    "@radix-ui/react-tooltip": "^1.0.7",
    "@stateset/design": "file:vendor/stateset-design",
    "@stateset/embedded": "file:../bindings/node",
    "@tanstack/react-table": "^8.11.8",
    "@tremor/react": "^3.14.1",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.0.0",
    "framer-motion": "^11.0.8",
    "lucide-react": "^0.265.0",
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "server-only": "^0.0.1",
    "sonner": "^1.7.0",
    "tailwind-merge": "^1.14.0",
    "tailwindcss-animate": "^1.0.6",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^16.1.6",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^20.19.0",
    "@types/react": "18.2.14",
    "@types/react-dom": "18.2.6",
    "@vitejs/plugin-react": "^5.1.2",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.14",
    "eslint": "^8.57.0",
    "eslint-config-next": "^14.1.0",
    "jsdom": "^27.0.1",
    "msw": "^2.12.7",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.3.3",
    "typescript": "5.1.6",
    "vitest": "^3.2.4"
  }
}
