# StateSet Admin Dashboard Environment Variables

# Browser-visible API URL used by client-side fetches and CSP (default: sandbox).
NEXT_PUBLIC_STATESET_API_URL=https://api.sandbox.stateset.app

# Server-side API URL used by Next route handlers.
# Defaults to NEXT_PUBLIC_STATESET_API_URL when unset, but set both in deployments.
STATESET_API_URL=https://api.sandbox.stateset.app

# API Token for server-side authentication (required for sessions API)
# Get this from the StateSet admin dashboard
STATESET_API_TOKEN=your_api_token_here

# Disable dashboard login and allow anonymous local admin access.
# Production ignores this flag and still requires a real session.
STATESET_ADMIN_DISABLE_AUTH=false

# Database path for embedded commerce engine (optional)
DATABASE_PATH=./data/admin.db

# Explicit demo-mode fallback when the native embedded module is unavailable.
# Production rejects this flag so admin fails closed on misconfiguration.
STATESET_ADMIN_ALLOW_MOCK_DATA=false
