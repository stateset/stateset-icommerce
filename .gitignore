# Rust
/target/
**/*.rs.bk
# Cargo.lock is committed for reproducible builds

# Node.js
# No trailing slash: worktrees symlink node_modules from the main checkout,
# and `node_modules/` matches only real directories, not the symlink.
node_modules
*.node
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
*.egg-info/
dist/
build/
.eggs/

# WASM
pkg/

# IDE
.idea/
.vscode/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Database files (for testing)
*.db
*.sqlite
*.db-wal
*.db-shm
*.db-journal

# Environment
.env
.env.local

# Build artifacts
*.dSYM/
# Local evidence and reports land under /artifacts/ (recovery drill, golden path,
# registry drift). The subdirectories below are TRACKED generated files that
# `npm run regen` and CI rewrite; un-ignoring them keeps their changes visible
# and lets a plain `git add` stage them without -f.
/artifacts/*
!/artifacts/compatibility/
!/artifacts/perf-regression/
examples/go/go
examples/go/go.exe
bindings/go/example/example
bindings/go/example/example.exe
examples/dotnet/bin/
examples/dotnet/obj/
examples/swift-basic/.build/
examples/kotlin/.gradle/

# Docs build outputs
docs/book/
docs/api/

# Java
bindings/java/target/
bindings/java/java/build/
bindings/java/java/.gradle/
*.class
*.jar

# Ruby
bindings/ruby/target/
bindings/ruby/lib/*.so
bindings/ruby/lib/*.dylib
bindings/ruby/lib/*.bundle
*.gem

# PHP
bindings/php/target/
bindings/php/modules/
*.php.bak

# CLI local state
cli/.stateset/
.stateset/
**/credentials.key
cli/node_modules_root_owned_*/

# Secrets (keep .template files, ignore filled-in secrets)
**/secrets.yaml
**/secrets.yml
**/secrets.json
!**/secrets.yaml.template

# Dev/test files
cli/test-*.mjs
cli/add-more-events.mjs

# Internal docs (not for public release)
FUTURE.md
PAPER.md
comparison_doc.md
CODEBASE_REVIEW.md

# Framework build output
.next/

# Admin dashboard local artifacts
.claude/*.local*
.claude/LOOP_PROGRESS.md
target-local/
target-codex/
.codex

# Coverage output directories (admin/ has its own .gitignore)
# Anchored so the tracked cli/src/coverage/ source dir is never matched.
/coverage/
cli/coverage/
bindings/*/coverage/
bindings/*/coverage-output.txt
tarpaulin-report.html
lcov.info

# Local performance-research harness state (points at out-of-tree tooling)
.autoresearch/

# local tooling
.worktrees/
.superpowers/

# .NET / Swift binding build outputs
bindings/dotnet/**/bin/
bindings/dotnet/**/obj/
bindings/swift/.build/
bindings/swift/Package.resolved
